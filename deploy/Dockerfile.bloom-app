# -------------------------------------------------------------------
# Stage 1: Builder — bun install + turbo/vite build
# Build context is the repo root (../../), like the backend Dockerfiles.
# -------------------------------------------------------------------
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Manifests first (cache-friendly): the install layer survives source edits.
COPY frontend/package.json frontend/bun.lock ./
COPY frontend/packages/bloom-ui/package.json packages/bloom-ui/
COPY frontend/packages/bloom-app/package.json packages/bloom-app/

RUN bun install --frozen-lockfile

COPY frontend/tsconfig.base.json frontend/turbo.json ./
COPY frontend/packages/bloom-ui/ packages/bloom-ui/
COPY frontend/packages/bloom-app/ packages/bloom-app/

# No VITE_* build args: axios falls back to '' (same-origin) and the nginx in
# stage 2 proxies /api to kactus-fin over the compose network.
RUN bunx turbo run build --filter=bloom-app

# -------------------------------------------------------------------
# Stage 2: Runtime — nginx serving the static bundle + /api reverse proxy
# -------------------------------------------------------------------
FROM nginx:alpine AS runtime

COPY --from=builder /app/packages/bloom-app/dist /usr/share/nginx/html
COPY deploy/nginx.bloom-app.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
