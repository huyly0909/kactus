# -------------------------------------------------------------------
# Stage 1: Builder
# -------------------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy workspace manifests first (cache-friendly layer). `uv sync --frozen`
# resolves against uv.lock, which names every workspace member, so all six
# manifests must be present even though this image only runs the data plane.
COPY pyproject.toml uv.lock ./
COPY libs/core/kactus-common/pyproject.toml libs/core/kactus-common/pyproject.toml
COPY libs/kactus-data/pyproject.toml libs/kactus-data/pyproject.toml
COPY libs/kactus-notification/pyproject.toml libs/kactus-notification/pyproject.toml
COPY services/kactus-fin/pyproject.toml services/kactus-fin/pyproject.toml
COPY services/kactus-fin-gateway/pyproject.toml services/kactus-fin-gateway/pyproject.toml
COPY services/kactus-data-server/pyproject.toml services/kactus-data-server/pyproject.toml

# Create stub packages so uv can resolve
RUN mkdir -p libs/core/kactus-common/src/kactus_common && \
    touch libs/core/kactus-common/src/kactus_common/__init__.py && \
    mkdir -p libs/kactus-data/src/kactus_data && \
    touch libs/kactus-data/src/kactus_data/__init__.py && \
    mkdir -p libs/kactus-notification/src/kactus_notification && \
    touch libs/kactus-notification/src/kactus_notification/__init__.py && \
    mkdir -p services/kactus-fin/src/kactus_fin && \
    touch services/kactus-fin/src/kactus_fin/__init__.py && \
    mkdir -p services/kactus-fin-gateway/src/kactus_fin_gateway && \
    touch services/kactus-fin-gateway/src/kactus_fin_gateway/__init__.py && \
    mkdir -p services/kactus-data-server/src/kactus_data_server && \
    touch services/kactus-data-server/src/kactus_data_server/__init__.py

# Install dependencies only (cached unless pyproject.toml changes)
RUN uv sync --package kactus-data-server --frozen --no-install-project

# Copy full source. The data plane ships kactus-data (scheduler, asset
# providers, DuckDB storage) but NOT kactus-notification: it sends nothing.
COPY libs/core/kactus-common/ libs/core/kactus-common/
COPY libs/kactus-data/ libs/kactus-data/
COPY services/kactus-data-server/ services/kactus-data-server/
COPY manage.py pytest.ini ./

# Install the project itself
RUN uv sync --package kactus-data-server --frozen

# -------------------------------------------------------------------
# Stage 2: Runtime
# -------------------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy venv from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/libs /app/libs
COPY --from=builder /app/services /app/services
COPY --from=builder /app/manage.py /app/manage.py

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# The DuckDB file. Mounted as a volume in compose so a container rebuild does
# not throw away every crawl; the path is absolute so it cannot land in the
# working directory by accident.
ENV KACTUS_DB_PATH=/data/kactus.duckdb
RUN mkdir -p /data

EXPOSE 17602

# ONE WORKER, permanently. This process holds the only read-write DuckDB handle
# in the deployment and runs the crawl scheduler; a second would mean an
# IOException on the lock file and a doubled vnstock rate-limit spend. There is
# no `--workers` option on `manage.py data-server` either, for the same reason.
CMD ["uvicorn", "kactus_data_server.app:app", "--host", "0.0.0.0", "--port", "17602", "--workers", "1"]
