# -------------------------------------------------------------------
# Stage 1: Builder
# -------------------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy workspace manifests first (cache-friendly layer). `uv sync --frozen`
# resolves against uv.lock, which names every workspace member, so all eight
# manifests must be present even though this image only runs the gateway.
COPY backend/pyproject.toml backend/uv.lock ./
COPY backend/libs/core/kactus-common/pyproject.toml libs/core/kactus-common/pyproject.toml
COPY backend/libs/domain/kactus-gold/pyproject.toml libs/domain/kactus-gold/pyproject.toml
COPY backend/libs/domain/kactus-stock-vn/pyproject.toml libs/domain/kactus-stock-vn/pyproject.toml
COPY backend/libs/kactus-data/pyproject.toml libs/kactus-data/pyproject.toml
COPY backend/libs/kactus-notification/pyproject.toml libs/kactus-notification/pyproject.toml
COPY backend/services/kactus-fin/pyproject.toml services/kactus-fin/pyproject.toml
COPY backend/services/kactus-fin-gateway/pyproject.toml services/kactus-fin-gateway/pyproject.toml
COPY backend/services/kactus-data-plane/pyproject.toml services/kactus-data-plane/pyproject.toml

# Create stub packages so uv can resolve
RUN mkdir -p libs/core/kactus-common/src/kactus_common && \
    touch libs/core/kactus-common/src/kactus_common/__init__.py && \
    mkdir -p libs/domain/kactus-gold/src/kactus_gold && \
    touch libs/domain/kactus-gold/src/kactus_gold/__init__.py && \
    mkdir -p libs/domain/kactus-stock-vn/src/kactus_stock_vn && \
    touch libs/domain/kactus-stock-vn/src/kactus_stock_vn/__init__.py && \
    mkdir -p libs/kactus-data/src/kactus_data && \
    touch libs/kactus-data/src/kactus_data/__init__.py && \
    mkdir -p libs/kactus-notification/src/kactus_notification && \
    touch libs/kactus-notification/src/kactus_notification/__init__.py && \
    mkdir -p services/kactus-fin/src/kactus_fin && \
    touch services/kactus-fin/src/kactus_fin/__init__.py && \
    mkdir -p services/kactus-fin-gateway/src/kactus_fin_gateway && \
    touch services/kactus-fin-gateway/src/kactus_fin_gateway/__init__.py && \
    mkdir -p services/kactus-data-plane/src/kactus_data_plane && \
    touch services/kactus-data-plane/src/kactus_data_plane/__init__.py

# Install dependencies only (cached unless pyproject.toml changes)
RUN uv sync --package kactus-fin-gateway --frozen --no-install-project

# Copy full source. The gateway only needs kactus-common; kactus-gold, kactus-stock-vn,
# kactus-data, kactus-notification and kactus-fin stay manifest-only stubs so
# the frozen workspace still resolves. Nothing zlapi-shaped reaches this image.
COPY backend/libs/core/kactus-common/ libs/core/kactus-common/
COPY backend/services/kactus-fin-gateway/ services/kactus-fin-gateway/
COPY backend/manage.py backend/pytest.ini ./

# Install the project itself
RUN uv sync --package kactus-fin-gateway --frozen

# -------------------------------------------------------------------
# Stage 2: Runtime
# -------------------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy venv from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/libs /app/libs
COPY --from=builder /app/services /app/services
COPY --from=builder /app/manage.py /app/manage.py

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

EXPOSE 17601

CMD ["uvicorn", "kactus_fin_gateway.app:app", "--host", "0.0.0.0", "--port", "17601"]
