# -------------------------------------------------------------------
# Stage 1: Builder
# -------------------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy workspace manifests first (cache-friendly layer). `uv sync --frozen`
# resolves against uv.lock, which names every workspace member, so all four
# manifests must be present even though this image only runs kactus-fin.
COPY pyproject.toml uv.lock ./
COPY libs/core/kactus-common/pyproject.toml libs/core/kactus-common/pyproject.toml
COPY libs/kactus-data/pyproject.toml libs/kactus-data/pyproject.toml
COPY services/kactus-fin/pyproject.toml services/kactus-fin/pyproject.toml
COPY services/kactus-fin-gateway/pyproject.toml services/kactus-fin-gateway/pyproject.toml

# Create stub packages so uv can resolve
RUN mkdir -p libs/core/kactus-common/src/kactus_common && \
    touch libs/core/kactus-common/src/kactus_common/__init__.py && \
    mkdir -p libs/kactus-data/src/kactus_data && \
    touch libs/kactus-data/src/kactus_data/__init__.py && \
    mkdir -p services/kactus-fin/src/kactus_fin && \
    touch services/kactus-fin/src/kactus_fin/__init__.py && \
    mkdir -p services/kactus-fin-gateway/src/kactus_fin_gateway && \
    touch services/kactus-fin-gateway/src/kactus_fin_gateway/__init__.py

# Install dependencies only (cached unless pyproject.toml changes)
RUN uv sync --package kactus-fin --frozen --no-install-project

# Copy full source. kactus-fin imports kactus-data (scheduler, asset providers,
# DuckDB storage), so that lib ships too — not just its manifest.
COPY libs/core/kactus-common/ libs/core/kactus-common/
COPY libs/kactus-data/ libs/kactus-data/
COPY services/kactus-fin/ services/kactus-fin/
COPY manage.py pytest.ini ./

# Install the project itself
RUN uv sync --package kactus-fin --frozen

# -------------------------------------------------------------------
# Stage 2: Runtime
# -------------------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy venv from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/libs /app/libs
COPY --from=builder /app/services /app/services
COPY --from=builder /app/manage.py /app/manage.py

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

EXPOSE 17600

CMD ["uvicorn", "kactus_fin.app:app", "--host", "0.0.0.0", "--port", "17600"]
