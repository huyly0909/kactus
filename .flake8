[flake8]
max-line-length=300
extend-ignore = E203, W503
exclude=.git,__pycache__,migrations,.idea,.venv
# Package __init__.py files declare MODELS (read by load_models() for Alembic
# autogenerate) above the re-exports, so their imports are legitimately not at
# the top of the file.
per-file-ignores =
    */__init__.py:E402
